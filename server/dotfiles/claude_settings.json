{
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "high"
    }
  },
  "theme": "auto",
  "tui": "default",
  "skillOverrides": {
    "anthropic-skills:docs": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:skill-creator": "off",
    "anthropic-skills:import-memory": "off"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "editorMode": "vim",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "claude_helpers flagged_cwd_alert \"Claude finished\"",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "claude_helpers flagged_cwd_alert \"Claude needs your input\"",
            "async": true
          }
        ]
      }
    ]
  },
"statusLine": {
  "type": "command",
  "command": "python3 ~/.claude/statusline.py"
}
}
