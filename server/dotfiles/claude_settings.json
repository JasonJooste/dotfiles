{
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "high"
    }
  },
  "theme": "auto",
  "tui": "default",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "editorMode": "vim",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "claude_helpers flagged_cwd_alert \"Claude finished\"",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "claude_helpers flagged_cwd_alert \"Claude needs your input\"",
            "async": true
          }
        ]
      }
    ]
  }
}
