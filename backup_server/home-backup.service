[Unit]
Description=Pull a snapshot of the laptop's home dir
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=oneshot
User=homebackup
Group=homebackup
ExecStart=/usr/local/lib/home-backup/pull_backup
Nice=10
IOSchedulingClass=idle
# Sandboxing: only the backup drive (added by install.sh in a drop-in) and the account's ssh dir are writable
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/homebackup/.ssh
