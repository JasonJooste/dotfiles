# rsync exclude patterns for the laptop's home dir. A leading / anchors to the top of ~, otherwise matches anywhere.

# Caches and trash
/.cache/
/.local/share/Trash/
/Downloads/
/snap/

# Games and other re-downloadable app data
/.local/share/Steam/
/.minecraft/
/.wine/

# Toolchains
/.rustup/
/.cargo/
/.pyenv/
/.npm/

# Build/env artifacts anywhere
node_modules/
.venv/
venv/
__pycache__/
